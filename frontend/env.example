# ===========================================
# SUPABASE CONFIGURATION
# ===========================================
# Required for authentication and database
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ===========================================
# API CONFIGURATION
# ===========================================
# Backend API URL
VITE_API_URL=http://localhost:8000/api/v1

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
# App name and branding
VITE_APP_NAME=iRepair Pro

# ===========================================
# FEATURE FLAGS
# ===========================================
# Enable/disable frontend features
VITE_ENABLE_CHATBOT=true
VITE_ENABLE_ORDER_TRACKING=true
VITE_ENABLE_QUOTE_SYSTEM=true
VITE_ENABLE_ADMIN_PANEL=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_NOTIFICATIONS=false

# ===========================================
# PAYMENT CONFIGURATION
# ===========================================
# Stripe public key for payments
VITE_STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key

# ===========================================
# ANALYTICS
# ===========================================
# Google Analytics tracking ID
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# ===========================================
# THEME CONFIGURATION
# ===========================================
# Theme and styling options
VITE_THEME=light
VITE_PRIMARY_COLOR=#3b82f6
VITE_SECONDARY_COLOR=#1e40af

# ===========================================
# PERFORMANCE CONFIGURATION
# ===========================================
# Performance and optimization settings
VITE_ENABLE_LAZY_LOADING=true
VITE_ENABLE_IMAGE_OPTIMIZATION=true
VITE_ENABLE_SERVICE_WORKER=false

# ===========================================
# DEBUG CONFIGURATION
# ===========================================
# Development and debugging options
VITE_DEBUG=false
VITE_LOG_LEVEL=info
VITE_ENABLE_DEVTOOLS=true
